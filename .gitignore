# Build output — regenerated by `pic-etl build`.
# The database itself is committed: it is the deliverable, it is 748 KB, and
# `pic-etl build` is byte-stable, so a rebuild that changes nothing produces no
# diff. Anyone can clone and query without running the pipeline.
build/*
!build/pic.sqlite

# Redundant with extracted/
PIC-Información-*.zip

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Generated by `pic-etl publish`
site/
